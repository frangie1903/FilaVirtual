<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="FilaVirtual.Pages.TurnosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mis turnos"
    BackgroundColor="#F5F7FC">

    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Grid.Row="0" Padding="20,24,20,10" Spacing="3">
            <Label Text="Mis turnos" FontSize="28" FontAttributes="Bold" TextColor="#101828"/>
            <Label Text="Consulta los turnos registrados" FontSize="13" TextColor="#667085"/>
        </VerticalStackLayout>

        <CollectionView x:Name="TurnosCollection" Grid.Row="1" Margin="18,4,18,8"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="24" Spacing="8" VerticalOptions="Center">
                    <Label Text="Todavía no hay turnos" FontSize="18" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" TextColor="#344054"/>
                    <Label Text="Pulsa Nuevo turno para registrar el primero."
                           HorizontalTextAlignment="Center" TextColor="#667085"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White" Stroke="#E5EAF2" StrokeThickness="1"
                            Padding="15" Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                              RowSpacing="4">
                            <Label Text="{Binding Numero}" FontSize="20" FontAttributes="Bold"
                                   TextColor="#101828"/>
                            <Border Grid.Column="1" BackgroundColor="#EAF2FF" StrokeThickness="0"
                                    Padding="9,4" VerticalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Label Text="{Binding Estado}" FontSize="11" TextColor="#0754D6"/>
                            </Border>
                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Negocio}"
                                   FontSize="13" TextColor="#475467"/>
                            <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Servicio}"
                                   FontSize="12" TextColor="#667085"/>
                            <Label Grid.Row="3" Grid.ColumnSpan="2"
                                   Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy}'}"
                                   FontSize="12" TextColor="#667085"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="+  Nuevo turno" Margin="20,5,20,18"
                HeightRequest="50" CornerRadius="12" BackgroundColor="#087BF5"
                TextColor="White" FontAttributes="Bold" Clicked="OnNuevoTurnoClicked"/>
    </Grid>
</ContentPage>
