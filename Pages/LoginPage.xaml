<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="FilaVirtual.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Iniciar sesión">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="20"
            VerticalOptions="Center">

            <VerticalStackLayout
                Spacing="5"
                HorizontalOptions="Center">

                <Label
                    Text="Fila Virtual"
                    FontSize="36"
                    FontAttributes="Bold"
                    TextColor="{StaticResource PrimaryColor}"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Gestiona tu turno de forma sencilla"
                    FontSize="15"
                    TextColor="{StaticResource GrayColor}"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">

                <Label
                    Text="Correo electrónico"
                    FontAttributes="Bold" />

                <Entry
                    Placeholder="ejemplo@correo.com"
                    Keyboard="Email" />

            </VerticalStackLayout>

            <VerticalStackLayout Spacing="8">

                <Label
                    Text="Contraseña"
                    FontAttributes="Bold" />

                <Entry
                    Placeholder="Contraseña"
                    IsPassword="True" />

            </VerticalStackLayout>

            <Button
                Text="Iniciar sesión"
                Margin="0,10,0,0" />

            <Label
                Text="¿No tienes una cuenta? Crear cuenta"
                TextColor="{StaticResource PrimaryColor}"
                HorizontalTextAlignment="Center"
                FontAttributes="Bold" />

            <Button
                Text="Continuar"
                Clicked="OnContinuarClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>